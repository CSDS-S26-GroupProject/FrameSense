FIREBASE_PROJECT_ID=framesense-cwru2026
FIRESTORE_CATALOG_COLLECTION=glassesFrames

# Pick one Firebase admin auth method (recommended: key file — avoids .env parse issues):
# Save the full JSON key next to the backend, gitignored, then:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-sa.json
# Or an absolute path. Relative paths are resolved from the backend/ directory.
#
# Inline JSON is supported only as a single line (multi-line JSON in .env breaks python-dotenv):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=framesense-assets
R2_PUBLIC_BASE_URL=https://pub-your-public-bucket-id.r2.dev
R2_SIGNED_URL_TTL_SECONDS=900

# SerpAPI (for glasses catalog search)
SERPAPI_API_KEY=your_serpapi_key_here
